[Unit]
Description=Turno Salud Agenda
After=network-online.target
Wants=network-online.target

[Service]
User=turnosalud
Group=turnosalud
WorkingDirectory=/opt/turno-salud/current/ms-agenda
EnvironmentFile=/etc/turno-salud/agenda.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
