[Unit]
Description=Turno Salud Citas
After=network-online.target
Wants=network-online.target

[Service]
User=turnosalud
Group=turnosalud
WorkingDirectory=/opt/turno-salud/current/ms-citas
EnvironmentFile=/etc/turno-salud/citas.env
ExecStart=/opt/turno-salud/current/ms-citas/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 3002
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
