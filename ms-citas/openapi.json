  "components": {
    "schemas": {
      "CitaOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "estado": {
            "type": "string",
            "enum": [
              "CONFIRMADA",
              "CANCELADA"
            ],
            "title": "Estado"
          },
          "medico_id": {
            "type": "string",
            "format": "uuid",
            "title": "Medico Id"
          },
          "fecha": {
            "type": "string",
            "format": "date",
            "title": "Fecha"
          },
          "hora": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "title": "Hora"
          },
          "paciente_nombre": {
            "type": "string",
            "title": "Paciente Nombre"
          },
          "documento": {
            "type": "string",
            "pattern": "^[0-9]{8}$",
            "title": "Documento"
          }
        },
        "type": "object",
        "required": [
          "id",
          "estado",
          "medico_id",
          "fecha",
          "hora",
          "paciente_nombre",
          "documento"
        ],
        "title": "CitaOut"
      },
      "CitaResponse": {
        "properties": {
          "cita": {
            "$ref": "#/components/schemas/CitaOut"
          }
        },
        "type": "object",
        "required": [
          "cita"
        ],
        "title": "CitaResponse"
      },
      "Credentials": {
        "properties": {
          "documento": {
            "type": "string",
            "pattern": "^[0-9]{8}$",
            "title": "Documento"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "documento",
          "password"
        ],
        "title": "Credentials"
      },
      "ErrorResponse": {
        "properties": {
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "code",
          "message",
          "correlation_id",
          "timestamp"
        ],
        "title": "ErrorResponse"
      },
      "Paciente": {
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Nombre"
          },
          "documento": {
            "type": "string",
            "pattern": "^[0-9]{8}$",
            "title": "Documento"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nombre",
          "documento"
        ],
        "title": "Paciente"
      },
      "Pagina": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CitaOut"
            },
            "type": "array",
            "title": "Items"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "page",
          "size",
          "total"
        ],
        "title": "Pagina"
      },
      "Registration": {
        "properties": {
          "documento": {
            "type": "string",
            "pattern": "^[0-9]{8}$",
            "title": "Documento"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "nombre": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Nombre"
          }
        },
        "type": "object",
        "required": [
          "documento",
          "password",
          "nombre"
        ],
        "title": "Registration"
      },
      "Reserva": {
        "properties": {
          "paciente": {
            "$ref": "#/components/schemas/Paciente"
          },
          "medico_id": {
            "type": "string",
            "format": "uuid",
            "title": "Medico Id"
          },
          "fecha": {
            "type": "string",
            "format": "date",
            "title": "Fecha"
          },
          "hora": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "title": "Hora"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "paciente",
          "medico_id",
          "fecha",
          "hora"
        ],
        "title": "Reserva"
      }
    }
  }
