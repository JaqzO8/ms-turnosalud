# LLM (Groq, API compatible con OpenAI). Pide tu key gratuita en console.groq.com
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# true = agente determinístico sin red (demo de emergencia) | false = Groq real
MOCK_LLM=true

# Microservicios (contratos §4; en compose usa los nombres de servicio, nunca localhost)
MS_AGENDA_URL=http://localhost:3001
MS_CITAS_URL=http://localhost:3002

# Guardarráiles
MAX_TOOL_CALLS=5
HTTP_TIMEOUT_MS=3000

# D6: fecha reproducible de evals (lunes)
FIXED_TODAY=2026-11-02

LOGS_DIR=logs
